{
  "expo": {
    "name": "WhimLore Mobile",
    "slug": "whimlore-mobile",
    "version": "1.0.0",
    "sdkVersion": "53.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "com.googleusercontent.apps.807110668374-skjoprepfpn386htfkil86is43tejb7o",
    "platforms": ["ios", "android", "web"],
    "splash": {
      "image": "./assets/images/Whimlore_ImageSCN.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "entryPoint": "./index.js", 
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.taytenacious.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDwEyfqFYC0Y7YypdUF-3icAFyFbSSRTS4"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7fb1f69a-4533-4bfd-b9ab-59ea9e0dbe63"
      }
    },
    "owner": "taytenacious",
    "plugins": ["expo-secure-store", "react-native-maps", "lottie-react-native"],
    "assetBundlePatterns": ["**/*"]
  }
}
